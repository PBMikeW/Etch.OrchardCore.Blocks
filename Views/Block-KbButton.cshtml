@* The sprite is served from the module's wwwroot under a stable name, so the
   path gets the same version stamp asp-append-version puts on the module's
   scripts - AddFileVersionToPath is what that tag helper calls. *@
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@{
    var style = !string.IsNullOrEmpty(Model.Style) ? Model.Style : "stdbluebutton";
    var label = !string.IsNullOrEmpty(Model.Label) ? Model.Label : "Button";
    var alignment = !string.IsNullOrEmpty(Model.Alignment) ? Model.Alignment : "left";
    var justify = alignment == "center" ? "center" : alignment == "right" ? "flex-end" : "flex-start";
    var targetAttr = Model.NewTab ? " target=\"_blank\" rel=\"noopener noreferrer\"" : "";
    var hasIcon = Model.HasIcon;
    bool inline = Model.Inline;

    // Inline buttons sit in a KbButtonGroup row: the row's gap does the spacing (so no
    // trailing margin from .stdbutton) and a label must never break inside its button,
    // otherwise a narrow screen squeezes the row instead of wrapping whole buttons.
    var linkStyles = new List<string>();
    if (hasIcon) { linkStyles.Add("display: inline-flex; align-items: center; gap: 0.4rem"); }
    if (inline) { linkStyles.Add("white-space: nowrap; margin-right: 0"); }
    var linkStyle = linkStyles.Count > 0 ? $" style=\"{string.Join("; ", linkStyles)}\"" : "";

    // Padding comes from the block's padding tune; rendered on this wrapper
    // (SelfPadded) so inline buttons keep flowing side by side.
    string Pad(object key) => key is string k && SpacerScale.Map.TryGetValue(k, out string v) ? v : null;
    string padTop = Pad(Model.PaddingTop);
    string padBottom = Pad(Model.PaddingBottom);
    string padLeft = Pad(Model.PaddingLeft);
    string padRight = Pad(Model.PaddingRight);

    // Inline buttons shrink-wrap inside their row (alignment is the row's job, see
    // Block-KbButtonGroup); full-width buttons justify themselves.
    var wrapperStyle = inline
        ? "display: inline-flex; vertical-align: top"
        : $"display: flex; justify-content: {justify}";
    if (padTop != null) { wrapperStyle += $"; padding-top: {padTop}"; }
    if (padBottom != null) { wrapperStyle += $"; padding-bottom: {padBottom}"; }
    if (padLeft != null) { wrapperStyle += $"; padding-left: {padLeft}"; }
    if (padRight != null) { wrapperStyle += $"; padding-right: {padRight}"; }

    // null, not empty: Razor drops an attribute whose value is null, and emits
    // the value HTML-encoded when it is not - which writing the id through
    // Html.Raw skipped, so an anchor tune carrying a quote broke out of the
    // attribute.
    string anchor = string.IsNullOrEmpty(Model.Anchor as string) ? null : (string)Model.Anchor;

    // Empty when the editor typed a URL that cannot go in an href (see
    // BlockLinkUrl). The button still renders, without a destination, rather
    // than as a javascript: link every visitor can click.
    string href = string.IsNullOrEmpty(Model.SafeUrl) ? null : (string)Model.SafeUrl;

    // Icons come from the module's sprite, so the icon set is one cached request
    // instead of its markup copied into every content item that uses it. The
    // symbols paint with currentColor, which takes the button's own text colour,
    // and em sizing keeps the icon in proportion to the label at any font size.
    // Buttons saved before the sprite existed have no icon name, only the markup
    // in their own data - those keep rendering it inline.
    bool useSprite = Model.UseSprite;
    string iconMarkup = null;
    if (hasIcon && useSprite)
    {
        string symbolId = Model.IconSymbolId;
        // ?v=… before the #fragment: a <use> resolves the document first and
        // then looks the symbol up inside it, so the query cannot go last.
        string spriteHref = System.Net.WebUtility.HtmlEncode(
            FileVersionProvider.AddFileVersionToPath(
                Context.Request.PathBase,
                Url.Content("~/Etch.OrchardCore.Blocks/assets/heroicons.svg")) + "#" + symbolId);
        iconMarkup = $"<svg class=\"kb-button-icon__svg\" width=\"1em\" height=\"1em\" aria-hidden=\"true\" focusable=\"false\"><use href=\"{spriteHref}\"></use></svg>";
    }
    else if (hasIcon)
    {
        iconMarkup = Model.IconSvg;
    }
}

<div style="@wrapperStyle" id="@anchor">
    <a href="@href" class="@style"@Html.Raw(targetAttr)@Html.Raw(linkStyle)>@if (hasIcon && Model.IsIconLeft)
    {<span class="kb-button-icon kb-button-icon--left">@Html.Raw(iconMarkup)</span>}@label@if (hasIcon && !Model.IsIconLeft)
    {<span class="kb-button-icon kb-button-icon--right">@Html.Raw(iconMarkup)</span>}</a>
</div>
